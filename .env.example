# ==============================================================================
# LedgerPulse Platform — Variáveis de Ambiente (Template)
# Copie este arquivo para `.env` se precisar customizar valores localmente.
# Nunca versione o arquivo `.env`.
# ==============================================================================

# --- PostgreSQL 16 (1 database `ledgerpulse` com schemas `ledger_core` e `webhooks`) ---
POSTGRES_DB=ledgerpulse
POSTGRES_USER=ledgerpulse
POSTGRES_PASSWORD=ledgerpulse_dev
# Se um PostgreSQL local já ocupar a porta 5432, copie `.env.example` para `.env`
# e defina POSTGRES_PORT=5433 (ou pare o serviço PostgreSQL local).
POSTGRES_PORT=5432

# --- Redis 7 ---
REDIS_PORT=6379

# --- RabbitMQ 3 Management ---
RABBITMQ_DEFAULT_USER=ledgerpulse
RABBITMQ_DEFAULT_PASS=ledgerpulse_dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Serviços da Aplicação (placeholders futuros; sem segredos reais) ---
# CORE_API_PORT=8080
# CORE_API_URL=http://localhost:8080
# RISK_ENGINE_PORT=8001
# RISK_ENGINE_URL=http://localhost:8001
# WEBHOOK_DISPATCHER_PORT=8082
# WEBHOOK_DISPATCHER_URL=http://localhost:8082
# WEB_CONSOLE_PORT=5173
# VITE_API_BASE_URL=http://localhost:8080/api/v1
